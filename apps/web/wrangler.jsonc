{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	// Web client + JSON API. Sign-in is Better Auth (Google, or a code by email) at /api/auth/*; every other
	// /api request needs its session. Secrets: `wrangler secret put BETTER_AUTH_SECRET` and GOOGLE_CLIENT_SECRET.
	"name": "magnus-web",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-26",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "mail.example.com", "custom_domain": true }],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"vars": {
		"BETTER_AUTH_URL": "https://mail.example.com",
		// From the Google Cloud OAuth client (docs/DEPLOY.md §4). Not a secret.
		"GOOGLE_CLIENT_ID": "",
		// Sends sign-in codes. Must match send_email's allowed sender, on a domain with Email Sending.
		"LOGIN_CODE_FROM": "login@example.com"
	},
	// Only for sign-in codes, and only as LOGIN_CODE_FROM. All other mail goes out through magnus-mailstore.
	"send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["login@example.com"] }],
	"d1_databases": [
		{
			"binding": "DIRECTORY",
			"database_name": "magnus-directory",
			// Replace with the id printed by `wrangler d1 create magnus-directory` (same value in apps/mx).
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "../../packages/directory/migrations"
		}
	],
	"r2_buckets": [{ "binding": "MAIL", "bucket_name": "magnus-mail" }],
	"durable_objects": {
		"bindings": [{ "name": "MAILBOX", "class_name": "Mailbox", "script_name": "magnus-mailstore" }]
	}
}
