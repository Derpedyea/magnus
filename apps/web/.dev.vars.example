# Copy to .dev.vars. Local only; never deployed.

# Skips sign-in as this directory user, and only on localhost. Remove it to try the real sign-in page.
# Email codes need a user whose login_email has a real domain; locally they land in .wrangler/tmp/email/.
DEV_USER_EMAIL=dev@localhost

BETTER_AUTH_URL=http://localhost:5173
# Any long random string locally (`openssl rand -base64 32`). Production uses `wrangler secret put`.
BETTER_AUTH_SECRET=
# Optional: a Google OAuth client with http://localhost:5173/api/auth/callback/google as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
