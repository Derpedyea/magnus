{
  "name": "magnus",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "imports": {
    "#shared": "./shared/index.ts",
    "#shared/*": "./shared/*.ts"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm typecheck && pnpm test && vite build && pnpm test:setup",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "postinstall": "tsc -p tsconfig.worker.json --noCheck",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.app.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:setup": "node --test scripts/setup.test.mjs",
    "cf-typegen": "wrangler types --strict-vars=false",
    "db:seed:local": "wrangler d1 migrations apply DIRECTORY --local && wrangler d1 execute DIRECTORY --local --file scripts/seed-dev.sql",
    "mail:test": "node scripts/send-test-email.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/zod-validator": "^0.9.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/react-virtual": "^3.14.13",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-bubble-menu": "^3.31.3",
    "@tiptap/extension-paragraph": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "better-auth": "1.7.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "hono": "^4.13.9",
    "input-otp": "^1.5.0",
    "linkifyjs": "^4.3.3",
    "lucide-react": "^1.48.0",
    "marked": "^17.0.6",
    "postal-mime": "^4.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.41",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "miniflare": "5.20260926.1-alpha",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.144.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "cloudflare": {
    "bindings": {
      "DIRECTORY": {
        "description": "People, domains, and addresses."
      },
      "MAIL": {
        "description": "Raw messages, bodies, and attachments."
      },
      "INBOUND": {
        "description": "Hands incoming mail from the SMTP session to the parser."
      }
    }
  }
}
