{
	"$schema": "node_modules/wrangler/config-schema.json",
	// One Worker does everything: email() takes mail at SMTP time, queue() parses it, fetch() serves the app and
	// its API, and the Mailbox Durable Object holds each mailbox. Resources have names but no IDs, so `wrangler
	// deploy` and the Deploy to Cloudflare button create them on first deploy. D1 migrations run from the Worker.
	"name": "magnus",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-26",
	"compatibility_flags": ["nodejs_compat"],
	// First visit goes to <name>.<subdomain>.workers.dev/setup. Add a custom domain whenever you like.
	"workers_dev": true,
	"preview_urls": false,
	// Local dev doesn't build or start the Proton export container, so it needs no Docker. To try an import locally,
	// run the container yourself and point PROTON_EXPORTER_URL at it (worker/optional.ts).
	"dev": { "enable_containers": false },
	"triggers": { "crons": ["0 * * * *"] },
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"assets": {
		"not_found_handling": "single-page-application",
		// /f/* serves files sent as download links, and the MTA-STS policy is served on mta-sts.<domain>.
		"run_worker_first": ["/api/*", "/f/*", "/.well-known/mta-sts.txt"]
	},
	// Setup proves you own this install by finding this exact version in your Cloudflare account.
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	"d1_databases": [{ "binding": "DIRECTORY", "database_name": "magnus-directory", "migrations_dir": "migrations" }],
	"r2_buckets": [{ "binding": "MAIL", "bucket_name": "magnus-mail" }],
	"durable_objects": {
		// Vault encrypts the saved Cloudflare token and keeps its key out of D1 and R2. ProtonImport runs an import from
		// Proton for one mailbox, in its container below.
		"bindings": [
			{ "name": "MAILBOX", "class_name": "Mailbox" },
			{ "name": "VAULT", "class_name": "Vault" },
			{ "name": "PROTON_IMPORT", "class_name": "ProtonImport" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["Mailbox"] },
		{ "tag": "v2", "new_sqlite_classes": ["Vault"] },
		{ "tag": "v3", "new_sqlite_classes": ["ProtonImport"] }
	],
	// Proton's Export Tool (container/proton-export/), one container per import running. Billed only while one runs.
	"containers": [
		{
			"class_name": "ProtonImport",
			"image": "./container/proton-export/Dockerfile",
			// The tool decrypts with one core and budgets 1.5 GiB of memory; exported mail waits on disk until it's filed.
			"instance_type": { "vcpu": 1, "memory_mib": 4096, "disk_mb": 8000 },
			"max_instances": 5
		}
	],
	"queues": {
		"producers": [{ "binding": "INBOUND", "queue": "magnus-inbound" }],
		"consumers": [
			// The Worker gives up parsing after 10 tries and lists the mail under Failed; the 10 retries after that are for
			// listing it.
			{ "queue": "magnus-inbound", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 20 },
			// Fed by an Email Sending event subscription per domain, which setup creates.
			{ "queue": "magnus-email-events", "max_batch_size": 50, "max_batch_timeout": 5, "max_retries": 5 }
		]
	},
	// Unrestricted: who may send as which address is decided against the D1 directory.
	"send_email": [{ "name": "EMAIL" }],
	// Checks mail from senders a mailbox doesn't know yet (worker/mail/checks.ts): Clef on Workers AI, then GPT-6 Luna
	// through OpenRouter, with its key stored on the `default` AI Gateway. Remote even in local dev, so that bills too.
	"ai": { "binding": "AI", "remote": true }
	// Nothing to configure. Optional secrets (Google sign-in, local dev) are listed in worker/optional.ts.
}
